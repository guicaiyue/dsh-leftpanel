{
  "name": "@zhujiuyi/dsh-leftpanel",
  "version": "0.1.0",
  "private": false,
  "description": "DeepSeek Harness plugin: fold every left-sidebar panel entry into one \"Collection\" row with a two-column card, and hide or show each panel entry. · DSH 插件：把左侧菜单的面板入口收进一行「集合」（悬浮展开双列卡片，默认开启），并逐个隐藏或显示面板入口。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.mjs\"",
    "check": "node --check index.js && node --check client/client.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "menu",
    "navigation",
    "collection"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhujiuyi/dsh-leftpanel.git"
  },
  "homepage": "https://github.com/zhujiuyi/dsh-leftpanel#readme",
  "bugs": {
    "url": "https://github.com/zhujiuyi/dsh-leftpanel/issues"
  },
  "author": {
    "name": "zhujiuyi"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
